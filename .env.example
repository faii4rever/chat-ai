# Port server (Pterodactyl biasanya inject otomatis lewat PORT/SERVER_PORT,
# baris ini cuma dipakai kalau jalan manual/lokal)
PORT=3000

# --- Provider bawaan buat visitor baru (opsional) ---
# Isi DUA-DUANYA kalau mau visitor baru yang belum pernah setting provider apa pun
# bisa langsung chat pakai kuota kamu, tanpa harus isi API key sendiri dulu.
# Kosongkan/hapus dua baris ini kalau tidak mau fitur ini aktif (default aman).
#
# PENTING: DEFAULT_BASE_URL di sini harus SAMA PERSIS dengan
# app.defaultProvider.baseUrl di public/config.js, kalau tidak sama kunci bawaan
# tidak akan kepakai (ini sengaja).
#
# JANGAN PERNAH taruh API key asli di public/config.js atau file lain di folder
# public/ - folder itu dikirim ke browser SIAPA PUN yang buka situsnya. Baris
# DEFAULT_API_KEY di file .env INI aman karena .env tidak pernah ikut ke-serve
# ke browser (dan jangan commit .env ke repo publik).
DEFAULT_BASE_URL=https://api.groq.com/openai/v1
DEFAULT_API_KEY=

# Batas pemakaian HARIAN (jumlah request) khusus buat visitor yang pakai kunci
# bawaan di atas - biar kalau situsnya rame/disalahgunakan, kuota/tagihan provider
# kamu tidak jebol. 0 = tanpa batas (TIDAK disarankan kalau DEFAULT_API_KEY diisi).
DEFAULT_KEY_DAILY_LIMIT=200
